# Project Environment Configuration
PROJECT_NAME="UK Wind Forecast Accuracy Dashboard"
DATABASE_PATH=data/wind_forecast.db

# Elexon BMRS API
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=20.0
ELEXON_MAX_RETRIES=3

# Evaluation Defaults
DEFAULT_DATE_FROM=2026-01-01
DEFAULT_DATE_TO=2026-01-31

# Demo Fallback
ALLOW_FIXTURE_FALLBACK=true

# Permitted CORS Origins (comma-separated or JSON list; wildcard '*' forbidden when credentials enabled)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
